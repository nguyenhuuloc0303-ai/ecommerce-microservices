{
  "info": {
    "name": "E-Commerce Microservices IUH - 25 Test Cases Suite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth - Register (TC-IAM-01)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"demo_user\",\"password\":\"Password@123\",\"email\":\"demo@iuh.edu.vn\"}"
        },
        "url": {
          "raw": "http://localhost:8080/api/auth/register",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      }
    },
    {
      "name": "2. Auth - Login Admin (TC-IAM-03)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json(); pm.environment.set('admin_token', jsonData.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"admin\",\"password\":\"Admin@123\"}"
        },
        "url": {
          "raw": "http://localhost:8080/api/auth/login",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "3. Products - Create Product (TC-PRO-01)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"pname\":\"Gaming Monitor 27 inch\",\"price\":300,\"quantity\":50}"
        },
        "url": {
          "raw": "http://localhost:8080/api/products",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "products"
          ]
        }
      }
    },
    {
      "name": "4. Products - Get Catalog (TC-PRO-02 / Redis Cache)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/products",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "products"
          ]
        }
      }
    },
    {
      "name": "5. Orders - Place Order (TC-ORD-01)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{cust_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"items\":[{\"pid\":1,\"qty\":2}]}"
        },
        "url": {
          "raw": "http://localhost:8080/api/orders",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "orders"
          ]
        }
      }
    },
    {
      "name": "6. Shipments - Get Shipment (TC-SHP-01)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{cust_token}}"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/shipments/5001",
          "host": [
