# Global Configuration
NODE_ENV=development
JWT_SECRET=super-secret-jwt-key-for-microservices-2026
PORT_GATEWAY=8080

# PostgreSQL (Identity, Customer, Order)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secret
POSTGRES_DB=postgres

IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=identity_pass
DATABASE_URL_IDENTITY=postgresql://identity_user:identity_pass@postgres:5432/identity_db

CUSTOMER_DB_NAME=customer_db
CUSTOMER_DB_USER=customer_user
CUSTOMER_DB_PASSWORD=customer_pass
DATABASE_URL_CUSTOMER=postgresql://customer_user:customer_pass@postgres:5432/customer_db

ORDER_DB_NAME=order_db
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=order_pass
DATABASE_URL_ORDER=postgresql://order_user:order_pass@postgres:5432/order_db

# MongoDB (Product, Shipment)
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin_secret
MONGO_INITDB_DATABASE=admin

PRODUCT_DB_NAME=product_db
PRODUCT_DB_USER=product_user
PRODUCT_DB_PASSWORD=product_pass
MONGO_URI_PRODUCT=mongodb://product_user:product_pass@mongo:27017/product_db?authSource=product_db

SHIPMENT_DB_NAME=shipment_db
SHIPMENT_DB_USER=shipment_user
SHIPMENT_DB_PASSWORD=shipment_pass
MONGO_URI_SHIPMENT=mongodb://shipment_user:shipment_pass@mongo:27017/shipment_db?authSource=shipment_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka (KRaft)
KAFKA_BROKER=kafka:9092
KAFKA_CLIENT_ID=ecommerce-platform

# Service Ports & gRPC Endpoints
IDENTITY_SERVICE_URL=http://identity-service:3001
CUSTOMER_SERVICE_URL=http://customer-service:3002
PRODUCT_SERVICE_URL=http://product-service:3003
ORDER_SERVICE_URL=http://order-service:3004
SHIPMENT_SERVICE_URL=http://shipment-service:3005

CUSTOMER_GRPC_HOST=customer-service:50052
PRODUCT_GRPC_HOST=product-service:50053

# Seed Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
SHIPMENT_STAFF_USERNAME=shipment_staff
SHIPMENT_STAFF_PASSWORD=Staff@123
